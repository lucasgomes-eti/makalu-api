# Copy to .env (untracked). Used by docker-compose.yml and as a reference for the
# environment variables the API reads for realtime. Never commit real values.
#
# Generate a development pair once:
#   docker run --rm emitter/server:v3.1 ./emitter license new
# It prints two lines:
#   [license] generated new license: <value>      -> EMITTER_LICENSE   (broker only)
#   [license] generated new secret key: <value>   -> EMITTER_SECRET_KEY (API only)
# The two belong together: a secret key only works with the license it was generated with.
EMITTER_LICENSE=
EMITTER_SECRET_KEY=
